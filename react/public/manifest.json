{
   "name":"BannerHero",
   "description":"Imports your schedule from Google Calendar",
   "version":"1.0.0",
   "manifest_version":3,
   "content_scripts":[
      {
         "matches":[
            "https://nubanner.neu.edu/StudentRegistrationSsb/ssb/registrationHistory/registrationHistory/*"
         ],
         "js":[
            "content/contentScript.js"
         ]
      }
   ],
   "action":{
      "default_popup":"../index.html"
   },
   "permissions":[
      "activeTab",
      "tabs",
      "identity",
      "webRequest"
   ],
   "host_permissions":[
      "https://nubanner.neu.edu/*",
      "https://apis.google.com/*",
      "*://*.google.com/*"
   ],
  "background": {
    "service_worker": "background/background.js",
     "type": "module"
  }
}